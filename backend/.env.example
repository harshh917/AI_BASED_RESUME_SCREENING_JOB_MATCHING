# --- Application ---
APP_NAME=AI Resume Matching System
ENVIRONMENT=development
DEBUG=true

# --- Database ---
# Full Postgres+pgvector connection string used in production/docker
DATABASE_URL=postgresql+psycopg2://resume_user:resume_pass@localhost:5432/resume_matching
# Used automatically by the test suite (no server required)
TEST_DATABASE_URL=sqlite:///./test.db

# --- Auth ---
JWT_SECRET_KEY=change_this_to_a_long_random_string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# --- Uploads ---
UPLOAD_DIR=../uploads/resumes
MAX_UPLOAD_SIZE_MB=5
ALLOWED_UPLOAD_EXTENSIONS=.pdf,.docx

# --- Embeddings ---
EMBEDDING_MODEL_NAME=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DIM=384

# --- CORS ---
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# --- Scoring weights (must sum to 1.0) ---
WEIGHT_SKILL=0.40
WEIGHT_SEMANTIC=0.25
WEIGHT_EXPERIENCE=0.15
WEIGHT_PROJECT=0.10
WEIGHT_EDUCATION=0.05
WEIGHT_CERTIFICATION=0.05
EMBEDDING_BACKEND=sentence_transformer
